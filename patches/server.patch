+    static bool HandleBlueprintPlace(ChatHandler* handler, uint32 entry, uint32 mapId,
+        float x, float y, float z, float facing, uint32 token,
+        Optional<float> qx, Optional<float> qy, Optional<float> qz, Optional<float> qw)
+    {
+        Player* player = handler->GetSession()->GetPlayer();
+        if (!player || !player->IsInWorld() || player->GetMapId() != mapId || player->GetTransport())
+            return BlueprintError(handler, "Carte differente, personnage hors du monde ou sur un transport.");
+        if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z) || !std::isfinite(facing))
+            return BlueprintError(handler, "Coordonnees non finies.");
+        QuaternionData rotation=QuaternionData::fromEulerAnglesZYX(facing,0.f,0.f);
+        bool full=qx.has_value()||qy.has_value()||qz.has_value()||qw.has_value();
+        if(full) {
+            if(!qx||!qy||!qz||!qw) return BlueprintError(handler,"Rotation incomplete.");
+            GMGizmo::Quat q{*qx,*qy,*qz,*qw};
+            if(!GMGizmo::Unit(q)) return BlueprintError(handler,"Rotation invalide.");
+            q=GMGizmo::Normalize(q);rotation=QuaternionData(float(q.x),float(q.y),float(q.z),float(q.w));
+            facing=float(GMGizmo::Yaw(q));
+        }
+        Position position(x, y, z, facing);
+        if (!position.IsPositionValid() || player->GetExactDist(&position) > 100.0f)
+            return BlueprintError(handler, "Position invalide ou a plus de 100 metres du personnage.");
+        GameObjectTemplate const* info = BlueprintTemplate(handler, entry);
+        if (!info)
+            return false;
+
+        // Protect the most recent placement per account against an accidental
+        // resend. No database schema change and no automatic client retry.
+        struct Receipt { uint32 token; ObjectGuid::LowType spawn; };
+        static std::unordered_map<uint32, Receipt> receipts;
+        uint32 account = handler->GetSession()->GetAccountId();
+        auto previous = receipts.find(account);
+        if (previous != receipts.end() && previous->second.token == token)
+        {
+            handler->PSendSysMessage("[WB:OK:%u:%u]", token, previous->second.spawn);
+            return true;
+        }
+
+        Map* map = player->GetMap();
+        GameObject* object = new GameObject();
+        if (!object->Create(map->GenerateLowGuid<HighGuid::GameObject>(), entry, map,
+            player->GetPhaseMaskForSpawn(), position, rotation, 255, GO_STATE_READY))
+        {
+            delete object;
+            return BlueprintError(handler, "Le serveur ne peut pas creer cet objet.");
+        }
+        object->SaveToDB(mapId, (1 << map->GetSpawnMode()), player->GetPhaseMaskForSpawn());
+        ObjectGuid::LowType spawn = object->GetSpawnId();
+        delete object;
+        object = new GameObject();
+        if (!object->LoadFromDB(spawn, map, true))
+        {
+            delete object;
+            handler->PSendSysMessage("[WB:ERROR] Sauvegarde effectuee (GUID %u), chargement impossible. Verifie cet objet avant de recommencer.", spawn);
+            return false;
+        }
+        sObjectMgr->AddGameobjectToGrid(spawn, sObjectMgr->GetGameObjectData(spawn));
+        if (receipts.size() >= 256)
+            receipts.erase(receipts.begin());
+        receipts[account] = {token, spawn};
+        handler->PSendSysMessage("[WB:OK:%u:%u]", token, spawn);
+        return true;
+    }
